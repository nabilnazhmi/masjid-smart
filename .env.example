# ==============================================================================
# MASJIDSMART AI - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

# Supabase PostgreSQL Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Server-side only, jangan bagikan ke frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# AI Provider API Keys (Pilih salah satu atau pasang Google Gemini)
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# (Opsional) OpenAI API Key jika menggunakan ChatGPT model
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Prayer Times Default City
NEXT_PUBLIC_PRAYER_CITY=Jakarta
